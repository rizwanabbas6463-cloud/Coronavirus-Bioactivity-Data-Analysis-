        "from rdkit import Chem\n",
        "from rdkit.ML.Descriptors import MoleculeDescriptors\n",
        "from rdkit.Chem import Descriptors\n",
        "import numpy as np\n",
        "\n",
        "# Generate RDKit descriptor names\n",
        "descriptor_names = [desc_name for desc_name, _ in Descriptors._descList]\n",
        "\n",
        "calc = MoleculeDescriptors.MolecularDescriptorCalculator(descriptor_names)\n",
        "\n",
        "def calc_descriptors(smiles):\n",
        "    mol = Chem.MolFromSmiles(smiles)\n",
        "    if mol is not None:\n",
        "        return calc.CalcDescriptors(mol)\n",
        "    else:\n",
        "        return [np.nan]*len(descriptor_names)\n",
        "\n",
        "# Compute descriptors\n",
        "X = df['canonical_smiles'].apply(calc_descriptors)\n",
        "X = pd.DataFrame(X.tolist(), columns=descriptor_names)\n",
        "\n",
        "# Combine with class label\n",
        "X['bioactivity_class'] = df['bioactivity_class']\n",
        "\n",
        "print(\"✅ Descriptors calculated:\", X.shape)\n",
        "X.head()\n"
